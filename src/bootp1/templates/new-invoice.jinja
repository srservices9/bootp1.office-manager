{% extends "invoices.jinja" %}
{% block style %}
<style>
        #ninvoice {
                margin-top: 75px;
                justify-content: center;
                align-items: center;
                display: flex;
        }
</style>
{% endblock %}
{% block page %}
<form id="ninvoice" method="post">
	<fieldset>
		<legend>Add Invoice</legend>
	        <input list="customers" placeholder="Customer">
	        <datalist id="customers">
	        {% if customers %}
	        {% for customer in customers %}
		        <option value="{{ customer.name }}">
	        {% endfor %}
	        {% endif %}
	        </datalist><br>
		<input type="text" id="inv_num" name="inv_num" placeholder="Invoice Number"><br>
		<select id="terms" name="terms" placeholder="Payment Terms">
                {% for term in terms %}
                        <option value="{{ term }}"
                {% endfor %}
                </select><br>
		<input type="text" id="total" name="total" placeholder="Invoice Total"><br>
                <button type="submit" id="ninvoice_submit">Submit</button>
	</fieldset>
</form>
{% endblock %}
