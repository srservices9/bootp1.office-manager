{% extends "items.jinja" %}
{% block style %}
<style>
        #nitem {
                margin-top: 75px;
                justify-content: center;
                align-items: center;
                display: flex;
        }
</style>
{% endblock %}
{% block page %}
<form id="nitem" method="post">
        {{ form.hidden_tag() }}
	<fieldset>
		<legend>Add Item</legend>
                {{ form.name.label }}
                {{ form.name() }}

                {{ form.default_description.label }}
                {{ form.default_description() }}

                {{ form.default_rate.label }}
                {{ form.default_rate() }}

                {{ form.submit()}}
	</fieldset>
</form>
{% endblock %}
