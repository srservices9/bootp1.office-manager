{% extends "items.jinja" %}

{% block style %}
<style>
	#item_search {
		margin-top: 50px;
		padding-left: 40px;
                justify-content: left;
                align-items: center;
                list-style-type: none;
		display: flex;
	}

	#items_table {
		padding-left:80px;
		justify-content:left;
		align-items: center;
		display: flex;
	}
</style>
{% endblock %}

{% block page %}
<form id="item_search" method="POST">
	{{ form.hidden_tag() }}
	<fieldset>
		<legend>Search for items</legend>
		{{ form.name.label }}
		{{ form.name() }}

		{{ form.description.label }}
		{{ form.description() }}

		{{ form.min_rate.label }}
		{{ form.min_rate() }}

		{{ form.max_rate.label }}
		{{ form.max_rate() }}

		{{ form.submit() }}
	</fieldset>
</form><br>

<table id="items_table">
	<tr>
		<th>Item Name</th>
		<th>Description</th>
		<th>Rate</th>
	</tr>
	{% if results %}
	{% for result in results %}
	<tr>
		<td>{{ result.name }}</td>
		<td>{{ result.default_description }}</td>
		<td>{{ result.default_rate }}</td>
	</tr>
	{% endfor %}
	{% endif %}
</table>
{% endblock %}
