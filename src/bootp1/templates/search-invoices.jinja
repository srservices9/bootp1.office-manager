{% extends "invoices.jinja" %}

{% block style %}
<style>
	#inv-search {
		margin-top: 50px;
		padding-left: 40px;
                justify-content: left;
                align-items: center;
                list-style-type: none;
		display: flex;
	}

	#inv-table {
		padding-left:80px;
		justify-content:left;
		align-items: center;
		display: flex;
	}
</style>
{% endblock %}

{% block page %}
<form id="inv-search" method="POST">
        {{ form.hidden_tag() }}
	<fieldset>
		<legend>Search for invoices</legend>
                {{ form.customer.label }}
                {{ form.customer() }}

                {{ form.invoice_num.label }}
                {{ form.invoice_num() }}

                {{ form.min_total.label }}
                {{ form.min_total() }}

                {{ form.max_total.label }}
                {{ form.max_total() }}

                {{ form.submit() }}
	</fieldset>
</form><br>

<table id="inv-table">
	<tr>
		<th>Invoice#</th>
		<th>Customer</th>
		<th>Terms</th>
		<th>Total</th>
	</tr>
	{% if results %}
	{% for result in results %}
	<tr>
		<td>{{ result.invoice_num }}</td>
		<td>{{ result.customer.name }}</td>
		<td>{{ result.terms }}</td>
		<td>{{ result.total }}</td>
	</tr>
	{% endfor %}
	{% endif %}
</table>
{% endblock %}
