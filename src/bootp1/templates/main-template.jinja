<!DOCTYPE html>
<html, lang="en">

        <style>
                .body {
                        margin: 0;
                        padding: 0;
                }

                .flash {
                        margin-left: 200px;
                        padding-left: 40px;
                }

                #sidebar {
                        top: 0;
                        left: 0;
                        list-style-type: none;
                        margin: 0;
                        padding: 0;
                        width: 200px;
                        background-color: #f1f1f1;
                        height: 100%;
                        position: fixed;
                        overflow: auto;
                }

                #inner_sidebar {
                        margin-top: 50px;
                        margin-left: 20px;
                        margin-right: 20px;
                        border-left: 1px solid green;
                        border-right: 1px solid green;
                        border-top: 1px solid green;
                }

                .section {
                        display: block;
                        height: 40px;
                        line-height: 40px;
                        text-align: center;
                        color: black;
                        border-bottom: 1px solid green;
                        text-decoration: none;
                }

                .section:hover {
                        background-color: green;
                        color: white;
                }

                #tab_bar {
                        display: flex;
                        justify-content: left;
                        align-items: center;
                        list-style-type: none;
                        margin: 0;
                        margin-left: 200px;
                        padding: 0;
                        padding-left: 40px;
                        height: 40px;
                        background-color: #f1f1f1;
                }

                .tab {
                        display: block;
                        height: 40px;
                        line-height: 40px;
                        padding-left: 14px;
                        padding-right: 16px;
                        color: black;
                        text-decoration: none;
                }

                .tab:hover {
                        background-color: green;
                        color: white;
                }

                #main_page {
                        margin-left: 200px;
                }
        </style>

        {% block style %}{% endblock %}

        <head>
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                {% block head %}
                <title>{% block title %}{% endblock %}</title>
                {% endblock %}
        </head>

        {% for message in get_flashed_messages() %}
        <div class="flash">{{ message }}</div>
        {% endfor %}

        <body class="body">
                <menu id="sidebar">
                        <div id="inner_sidebar">
                                <li><a class="section" href="/home">Home</a></li>
                                <li><a class="section" href="/customers">Customers</a></li>
                                <li><a class="section" href="/items">Items</a></li>
                                <li><a class="section" href="/invoices">Invoices</a></li>
                                <li><a class="section">Estimates</a></li>
                                <li><a class="section">Vehicles</a></li>
                                <li><a class="section">Insurance</a></li>
                        </div>
                </menu>


                <menu id="tab_bar">
                        {% block tabs %}
                        {% endblock %}
                </menu>
                <div id="main_page">
                        {% block page %}
                        {% endblock %}
                </div>
        </body>

        </html>
