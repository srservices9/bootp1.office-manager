{% extends "home.jinja" %}

{% block style %}
<style>
        #login {
                margin-top: 75px;
                justify-content: center;
                align-items: center;
                display: flex;
        }
</style>
{% endblock %}

{% block page %}
<form id="login">
	<fieldset>
		<legend>Login</legend>
		<input type="text" id="uname" name="uname" placeholder="Username"><br>
		<input type="text" id="pw" name="pw" placeholder="Password"><br>
	</fieldset>
</form>
{% endblock %}
