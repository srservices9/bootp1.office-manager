{% extends "customers.jinja" %}

{% block style %}
<style>
	#customer-search {
		margin-top: 50px;
		padding-left: 40px;
                justify-content: left;
                align-items: center;
                list-style-type: none;
		display: flex;
	}
</style>
{% endblock %}

{% block page %}
<form id="customer-search">
	<label for="customers">Search by customer:</label><br>
	<input list="customers" {% if not customers %}placeholder="No customers"{% endif %}>
	<datalist id="customers">
	{% if customers %}
	{% for customer in customers %}
		<option value="{{ customer.name }}">
	{% endfor %}
	{% endif %}
	</datalist>
</form>
{% endblock %}
