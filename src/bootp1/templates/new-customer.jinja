{% extends "customers.jinja" %}

{% block style %}
<style>
        #ncustomer {
		margin-top: 50px;
		padding-left: 40px;
                justify-content: left;
                align-items: center;
                list-style-type: none;
		display: flex;
        }
</style> 
{% endblock %}

{% block page %}
<form id="ncustomer" method="post">
        {{ form.hidden_tag() }}
	<fieldset>
		<legend>Add Customer</legend>
                {{ form.name.label }}
                {{ form.name() }}

                {{ form.contact_first_name.label }}
                {{ form.contact_first_name() }}

                {{ form.contact_last_name.label }}
                {{ form.contact_last_name() }}

                {{ form.contact_phone.label }}
                {{ form.contact_phone() }}

                {{ form.submit() }}
	</fieldset>
</form>
{% endblock %}
